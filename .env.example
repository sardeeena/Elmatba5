# GEMINI_API_KEY: Required for Gemini AI API calls (Phase 3+).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (used for CORS & auth redirect validation).
APP_URL="http://localhost:3000"

# CORS_ORIGIN: Optional comma-separated list of additional allowed browser origins.
# CORS_ORIGIN="https://app.elmatba5.com"

# SESSION_SECRET: Required server secret in production (minimum 32 random characters).
SESSION_SECRET="CHANGE_ME_IN_PRODUCTION_32_CHARS_MIN"

# SUPABASE CONFIGURATION (Required — uses Publishable key + RLS, NO secret/service_role key):
# AI Studio automatically injects SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY from Secrets.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"

# EXTERNAL SEO & PAYMENT PROVIDERS (Server-side only — Phase 2B+):
# DATAFORSEO_LOGIN=""
# DATAFORSEO_PASSWORD=""
# GOOGLE_SEARCH_CONSOLE_CLIENT_ID=""
# GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=""
# YANDEX_SEARCH_API_KEY=""
# PAYMOB_API_KEY=""
# PAYMOB_HMAC_SECRET=""
